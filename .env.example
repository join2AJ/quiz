# Password for the built-in "admin" account (required — admin login is disabled without it)
ADMIN_PASSWORD=change-me-to-something-strong

# Secret used to sign session cookies. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Port the server listens on (Railway/Render set this automatically)
PORT=4000

# Where Excel files are stored. Defaults to backend/data. Point this at a
# persistent volume in production (e.g. /data on Railway).
# DATA_DIR=/data

# Timezone used for the times written into Excel
TIMEZONE=Asia/Kolkata

# In production, session cookies are HTTPS-only. Set to false only if you serve
# the app over plain HTTP (e.g. on an office LAN IP).
# COOKIE_SECURE=false

# Number of proxies in front of the server (defaults to 1 in production).
# TRUST_PROXY=1

# Supabase storage (required on Netlify; optional elsewhere). Project Settings → API.
# Use the service_role key — server side only, never in the frontend.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
